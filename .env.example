# Bu dosyayı .env adıyla kopyalayın; gerçek değerleri yalnızca sunucuda doldurun.
NODE_ENV=production
PUBLIC_SITE=1
SITE_URL=https://www.ozkanofset.com
# Farklı bir alan adı da uygulamaya yönleniyorsa virgülle ekleyin.
ALLOWED_HOSTS=ozkanofset.com,www.ozkanofset.com
ADMIN_USER=admin
ADMIN_PASSWORD=
# Hosting sağlayıcısının verdiği port/bind değerleri esas alınır.
PORT=4000
HOST=127.0.0.1
# Yalnızca Node.js'e gerçekten bağlanan güvenilir proxy IP'lerini yazın.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=www.ozkanofset.com
# İsteğe bağlı: Linux ClamAV veya sunucunuzdaki tarayıcının tam yolu.
# Yapılandırılmazsa müşteri dosyası yükleme kapalı kalır; dosyasız talep çalışır.
ANTIVIRUS_SCANNER=
